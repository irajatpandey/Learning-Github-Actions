name: my-service-Pipeline

on:
  push:
    branches:
      - master
      - feature/**
      - release/**
  pull_request:
    branches:
      - master
      - release/**
  workflow_dispatch:
    inputs:
      python-version:
        description: Python version
        required: false
        type: string
        default: "3.12"

      exclusions:
        description: SonarQube exclusions
        required: false
        type: string
        default: ""

jobs:
  ci-pipeline-jobs:
    permissions:
      contents: write
      pages: write
      id-token: write
    uses: irajatpandey/platform-workflows/.github/workflows/python-ci.yml@master
    with:
      python-version: ${{ inputs.python-version }}
      exclusions: ${{ inputs.exclusions }}
    secrets: inherit
